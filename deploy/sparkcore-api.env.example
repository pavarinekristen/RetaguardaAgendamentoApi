# Template de /etc/sparkcore/sparkcore-api.env
# Copiar para a VPS, preencher os TROCAR_* e proteger:
#   sudo mkdir -p /etc/sparkcore
#   sudo cp sparkcore-api.env.example /etc/sparkcore/sparkcore-api.env
#   sudo chmod 600 /etc/sparkcore/sparkcore-api.env
#   sudo chown root:root /etc/sparkcore/sparkcore-api.env
#
# NUNCA commitar o arquivo preenchido.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

# Senhas = as definidas via ALTER ROLE depois do apply-postgres-migrations.sh
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=55432;Database=retaguarda_agendamento;Username=agenda_user;Password=TROCAR_SENHA_AGENDA_USER;Search Path=retaguarda_agendamento
ConnectionStrings__AdminConnection=Host=127.0.0.1;Port=55432;Database=retaguarda_agendamento;Username=agenda_admin;Password=TROCAR_SENHA_AGENDA_ADMIN;Search Path=agenda_operacional
AgendaOperacionalDatabase=agenda_operacional

# E-mail (deixar Enabled=false ate configurar um app password real)
Email__Enabled=false
Email__Host=smtp.gmail.com
Email__Port=587
Email__EnableSsl=true
Email__From=TROCAR_EMAIL
Email__DisplayName=SparkCore
Email__Username=TROCAR_EMAIL
Email__Password=TROCAR_APP_PASSWORD
Email__ReturnConfirmationCodeInResponse=false

# CORS: origens que podem chamar a API pelo navegador
Cors__AllowedOrigins__0=https://laudos.clinicaideia.com.br

# Atras do Nginx local (ja habilitado no appsettings.Production.json; aqui e redundancia explicita)
ForwardedHeaders__Enabled=true
